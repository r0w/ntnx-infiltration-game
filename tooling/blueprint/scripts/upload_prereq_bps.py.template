#script

"""
Upload CloneProd + BlankVM-source prereq blueprints.

The .tgz blobs are pre-patched at BUILD time (build_blueprint.py opens
each tar, sed-substitutes `{X}` placeholders to Calm `@@{X}@@` tokens,
re-tars, base64-encodes, and inlines the result here). At RUN time we
only decode the base64 and POST — no `tarfile`, no `io`, none of the
sandbox-banned modules.

Multipart body is hand-constructed so we don't need `requests.files=`
(which calls `urllib3.filepost` which calls `email.mime` which calls
`os.urandom` — at least one link in that chain is a sandbox blocker).

Calm injects @@{PC_IP}@@, @@{PC_USERNAME}@@, @@{PC_PASSWORD}@@,
@@{Game.ProjectUUID}@@.
"""

import base64
import sys
import time
import urllib3
import uuid

import requests

urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

PC_IP = '@@{PC_IP}@@'
PC_USERNAME = '@@{PC_USERNAME}@@'
PC_PASSWORD = '@@{PC_PASSWORD}@@'
# May be empty when this branch starts before Branch 1's "Setup
# production project" SET_VAR has run — Calm DSL 4.3.1 can't express
# cross-branch waits in a single parallel block. We resolve by name
# from the PC API instead (resolve_project_uuid below). Kept as the
# fast-path because @@{Game.ProjectUUID}@@ does land correctly when
# the SET_VAR finishes before this task starts (re-runs as day-2,
# operator-launched, etc.).
PROJECT_UUID = '@@{Game.ProjectUUID}@@'
PROJECT_NAME = "production"

BASE = "https://%s:9440" % PC_IP
AUTH = (PC_USERNAME, PC_PASSWORD)

# Poll cap for the cross-branch wait. Branch 1's chain to "Setup
# production project" is: Ensure host 4 removed (~3 min API + cluster
# pin) → Wait for cluster health (poll until NORMAL) → Setup subnets
# (~5 s) → Setup production project. Worst case ~10 min on a slow
# shrink. 12 min cap = 24 polls × 30 s, generous on top.
PROJECT_WAIT_TIMEOUT_SEC = 12 * 60
PROJECT_WAIT_INTERVAL_SEC = 30


def resolve_project_uuid():
    """Look up the `production` project's UUID via PC API. Used when the
    Calm-injected ProjectUUID is empty (cross-branch wait), or as a
    sanity re-check when it's set. Returns None on timeout."""
    r = requests.post(
        "%s/api/nutanix/v3/projects/list" % BASE,
        auth=AUTH,
        headers={"Accept": "application/json", "Content-Type": "application/json"},
        verify=False, timeout=20,
        json={"kind": "project", "filter": "name==%s" % PROJECT_NAME, "length": 1},
    )
    r.raise_for_status()
    entities = r.json().get('entities') or []
    if not entities:
        return None
    return entities[0]['metadata']['uuid']


def wait_for_project():
    """Poll for the `production` project until it appears or we time
    out. Returns the UUID, or raises after the cap."""
    deadline_iter = PROJECT_WAIT_TIMEOUT_SEC // PROJECT_WAIT_INTERVAL_SEC
    for i in range(deadline_iter):
        elapsed = i * PROJECT_WAIT_INTERVAL_SEC
        try:
            uuid_ = resolve_project_uuid()
        except Exception as e:
            print("  [+%ds] project lookup transient: %s" % (elapsed, str(e)[:120]))
            time.sleep(PROJECT_WAIT_INTERVAL_SEC)
            continue
        if uuid_:
            print("  [+%ds] resolved project '%s' = %s" % (elapsed, PROJECT_NAME, uuid_))
            return uuid_
        print("  [+%ds] project '%s' not yet listed; Branch 1 still upstream"
              % (elapsed, PROJECT_NAME))
        time.sleep(PROJECT_WAIT_INTERVAL_SEC)
    raise Exception(
        "project '%s' did not appear within %d min — Branch 1 (Setup "
        "production project) likely failed; check the install runbook."
        % (PROJECT_NAME, PROJECT_WAIT_TIMEOUT_SEC // 60)
    )

CLONEPROD_TGZ_B64 = "__CLONEPROD_TGZ_B64__"
BLANKVM_TGZ_B64 = "__BLANKVM_TGZ_B64__"


def existing_bp_uuid(name):
    r = requests.post(
        "%s/api/nutanix/v3/blueprints/list" % BASE,
        auth=AUTH,
        headers={"Accept": "application/json", "Content-Type": "application/json"},
        verify=False, timeout=20,
        json={"kind": "blueprint", "filter": "name==%s" % name, "length": 1},
    )
    r.raise_for_status()
    entities = r.json().get('entities') or []
    return entities[0]['metadata']['uuid'] if entities else None


def upload_via_multipart(name, tgz_bytes):
    """Hand-rolled multipart/form-data POST (no requests.files=, no io)."""
    boundary = "calmboundary" + uuid.uuid4().hex
    crlf = b"\r\n"
    parts = []
    parts.append(("--" + boundary).encode())
    parts.append(b'Content-Disposition: form-data; name="name"')
    parts.append(b"")
    parts.append(name.encode())
    parts.append(("--" + boundary).encode())
    parts.append(b'Content-Disposition: form-data; name="project_uuid"')
    parts.append(b"")
    parts.append(PROJECT_UUID.encode())
    parts.append(("--" + boundary).encode())
    parts.append(
        ('Content-Disposition: form-data; name="file"; filename="%s.tgz"' % name).encode()
    )
    parts.append(b"Content-Type: application/gzip")
    parts.append(b"")
    parts.append(tgz_bytes)
    parts.append(("--" + boundary + "--").encode())
    parts.append(b"")
    body = crlf.join(parts)
    headers = {
        "Accept": "application/json",
        "Content-Type": "multipart/form-data; boundary=" + boundary,
    }
    r = requests.post(
        "%s/api/nutanix/v3/blueprints/import_file" % BASE,
        auth=AUTH, headers=headers, verify=False, timeout=120,
        data=body,
    )
    if r.status_code >= 400:
        return False, "%d %s" % (r.status_code, r.text[:300])
    return True, "uploaded (%d bytes)" % len(tgz_bytes)


def handle_one(name, tgz_b64):
    if existing_bp_uuid(name):
        print("[skip] '%s' BP already on PC" % name)
        return True
    if not tgz_b64 or tgz_b64.startswith("__"):
        print("[FAIL] '%s' tgz blob not injected — build step missed?" % name)
        return False
    print("Uploading '%s' (pre-patched at build) ..." % name)
    tgz = base64.b64decode(tgz_b64)
    ok, msg = upload_via_multipart(name, tgz)
    print("  %s %s" % ("[ok]" if ok else "[FAIL]", msg))
    return ok


def main():
    global PROJECT_UUID  # noqa: PLW0603
    if not PROJECT_UUID:
        print(
            "[info] @@{Game.ProjectUUID}@@ empty (cross-branch wait); polling "
            "PC for project '%s' (cap %d min)..."
            % (PROJECT_NAME, PROJECT_WAIT_TIMEOUT_SEC // 60)
        )
        PROJECT_UUID = wait_for_project()
    print("[info] using project_uuid=%s" % PROJECT_UUID)
    success = True
    success &= handle_one("CloneProd", CLONEPROD_TGZ_B64)
    success &= handle_one("BlankVM-source", BLANKVM_TGZ_B64)
    return 0 if success else 1


sys.exit(main())
