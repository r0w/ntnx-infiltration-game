#!/bin/bash
set -euo pipefail

# Push CloneProd + BlankVM-source prereq blueprints to Calm.
#
# Calm's `import_file` API only accepts a JSON BP body (not a raw .tgz),
# so the legacy approach was: extract the .tgz, sed-substitute placeholders
# in the calm-dsl Python source, then run `calm create bp -f blueprint.py`
# from a calm-dsl Docker container. We do the same here.
#
# The .tgz blobs are base64-inlined at build time by build_blueprint.py
# (replaces the two placeholders below).
#
# Idempotent — both `calm create bp` calls use --force so re-runs
# overwrite stale copies.

PC_IP="@@{PC_IP}@@"
PC_USER="@@{PC_USERNAME}@@"
PC_PWD="@@{PC_PASSWORD}@@"
CLUSTER_NAME="@@{CLUSTERNAME}@@"

CALM_DSL_IMAGE="${CALM_DSL_IMAGE:-nutanix/calm-dsl:v4.3.1}"
WORKDIR="$HOME/calm-dsl-staging"
DSLDIR="$WORKDIR/.calm"

mkdir -p "$WORKDIR"
cd "$WORKDIR"

# 1. Decode the base64-inlined .tgz blobs
echo "[push_prereq_bps] decoding inlined .tgz blobs..."
echo "__CLONEPROD_TGZ_B64__" | base64 -d > CloneProd.tgz
echo "__BLANKVM_TGZ_B64__" | base64 -d > NewblankVM.tgz

# 2. Extract + sed-substitute placeholders (legacy convention: {X} → @@{X}@@
#    for runtime resolution by Calm, plus {PROJECT} → "production" literal
#    for calm-dsl compile-time resolution)
echo "[push_prereq_bps] extracting + patching..."
rm -rf CloneProd NewblankVM
tar xzf CloneProd.tgz
tar xzf NewblankVM.tgz

sed -i 's/{PC_IP}/@@{PC_IP}@@/g'         CloneProd/blueprint.py
sed -i 's/{PC_USER}/@@{PC_USERNAME}@@/g' CloneProd/blueprint.py
sed -i 's/{PC_PWD}/@@{PC_PASSWORD}@@/g'  CloneProd/blueprint.py
sed -i 's/{PROJECT}/production/g'         CloneProd/blueprint.py

sed -i "s/{CLUSTER_NAME}/$CLUSTER_NAME/g" NewblankVM/blueprint.py
sed -i 's/{PROJECT}/production/g'         NewblankVM/blueprint.py

# 3. Pull the calm-dsl Docker image (need docker — installed by upstream
#    Install Docker task)
echo "[push_prereq_bps] pulling calm-dsl image $CALM_DSL_IMAGE ..."
sudo docker pull "$CALM_DSL_IMAGE"

# 4. Write calm-dsl config files directly — DO NOT call `calm init dsl`.
#    `init dsl` probes /api/calm/v3.0/features/approval_policy at startup,
#    which times out (30 s default) while the policy engine MSP is still
#    bootstrapping during install (this branch fires shortly after
#    `Activate policy engine` returns success best-effort, but the
#    underlying MSP service typically takes 5-15 min to come up — see
#    memory project_calm_policy_vm_unstable). We don't need the probe;
#    `calm create bp` only reads the project name from config.ini and
#    queries /api/nutanix/v3/projects/list directly. Writing the same
#    shape `init dsl` would produce on success skips the failure mode
#    entirely.
echo "[push_prereq_bps] writing calm-dsl config (skip init dsl probe)..."
mkdir -p "$DSLDIR/.local"
cat > "$DSLDIR/config.ini" <<EOF
[SERVER]
pc_ip = $PC_IP
pc_port = 9440
pc_username = $PC_USER
pc_password = $PC_PWD
api_key_location = -

[NCM_SERVER]
ncm_enabled = False
host = None
port = None

[NC_SERVER]
enabled = False
host = None
username = admin
password = stub

[PROJECT]
name = production

[LOG]
level = INFO

[POLICY]
policy_status = False

[APPROVAL_POLICY]
approval_policy_status = True

[STRATOS]
stratos_status = False

[CLOUD_PROVIDERS]
cp_status = True

[CONNECTION]
retries_enabled = True
connection_timeout = 5
read_timeout = 30

[CATEGORIES]
EOF
cat > "$DSLDIR/init.ini" <<EOF
[CONFIG]
location = /root/.calm/config.ini

[DB]
location = /root/.calm/dsl.db

[LOCAL_DIR]
location = /root/.calm/.local
EOF

# 5. Refresh the cache so Ref.Project("production") resolves
echo "[push_prereq_bps] updating calm-dsl cache..."
sudo docker run --rm \
    -v "$DSLDIR:/root/.calm" \
    "$CALM_DSL_IMAGE" \
    calm update cache

# 6. Create both BPs
push_bp() {
    local bp_dir="$1"
    local bp_name="$2"
    echo "[push_prereq_bps] creating BP '$bp_name' from $bp_dir/blueprint.py ..."
    sudo docker run --rm \
        -v "$DSLDIR:/root/.calm" \
        -v "$WORKDIR:/work" \
        -w "/work" \
        "$CALM_DSL_IMAGE" \
        calm create bp --file "$bp_dir/blueprint.py" --name "$bp_name" --force
}

push_bp CloneProd CloneProd
push_bp NewblankVM BlankVM-source

# 7. Set the CloneProd `pcUser` credential to the real PC admin creds.
#    The source blueprint ships placeholder creds ({PC_USER}/{PC_PWD}) that
#    the sed pass above rewrites to Calm macros. That path is fragile: it
#    relies on calm-dsl round-tripping the plaintext secret on `create bp`,
#    and a password containing a sed metachar (e.g. `/`) corrupts the
#    substitution outright — either way the launched CloneProd app's install
#    runbook 401s on its first authenticated call. Stage 35 used to make the
#    player fix this by hand in the UI, where a typo can lock the admin
#    account. Set it explicitly here once, via the v3 blueprints API (mirrors
#    the auto-play act `actCloneAppBlueprint`), from the same PC creds Calm
#    already injected above. The PUT only stores the secret on the BP (no
#    login), so it can't lock anything. Best-effort: on failure we fall back
#    to the old manual step (and the act re-patches the same cred at launch),
#    so it must NOT abort the rest of the deploy.
echo "[push_prereq_bps] patching CloneProd pcUser credential..."
PC_IP="$PC_IP" PC_USER="$PC_USER" PC_PWD="$PC_PWD" python3 - <<'PY' || true
import base64, json, os, ssl, sys, urllib.error, urllib.request

PC_IP, PC_USER, PC_PWD = os.environ["PC_IP"], os.environ["PC_USER"], os.environ["PC_PWD"]
BASE = f"https://{PC_IP}:9440"
AUTH = "Basic " + base64.b64encode(f"{PC_USER}:{PC_PWD}".encode()).decode()
CTX = ssl.create_default_context()
CTX.check_hostname = False
CTX.verify_mode = ssl.CERT_NONE

def call(method, path, body=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(BASE + path, data=data, method=method)
    req.add_header("Authorization", AUTH)
    req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, context=CTX, timeout=60) as r:
            res = r.read().decode()
            return json.loads(res) if res else None
    except urllib.error.HTTPError as e:
        # Surface the Nutanix error body — a bare "HTTP 400" hides the actual
        # validation message and makes a failed deploy patch undebuggable.
        try:
            err = e.read().decode()
        except Exception:
            err = ""
        raise RuntimeError(f"HTTP {e.code} {method} {path}: {err[:300]}") from e

try:
    lst = call("POST", "/api/nutanix/v3/blueprints/list",
               {"length": 250, "filter": "name==CloneProd"})
    ents = [e for e in lst.get("entities", [])
            if e.get("status", {}).get("name") == "CloneProd"]
    if not ents:
        print("[push_prereq_bps] WARN CloneProd not found, skipping cred patch")
        sys.exit(0)
    uuid = ents[0]["metadata"]["uuid"]
    full = call("GET", f"/api/nutanix/v3/blueprints/{uuid}")
    creds = full.get("spec", {}).get("resources", {}).get("credential_definition_list", [])
    pc = next((c for c in creds if c.get("name") == "pcUser"), None)
    if pc is None:
        print("[push_prereq_bps] WARN pcUser credential absent, skipping patch")
        sys.exit(0)
    pc["username"] = PC_USER
    pc["secret"] = {"value": PC_PWD, "attrs": {"is_secret_modified": True}}
    call("PUT", f"/api/nutanix/v3/blueprints/{uuid}",
         {"api_version": full.get("api_version", "3.1"),
          "metadata": full["metadata"], "spec": full["spec"]})
    print(f"[push_prereq_bps] CloneProd pcUser credential patched (username={PC_USER})")
except Exception as e:
    print(f"[push_prereq_bps] WARN cred patch failed (non-fatal): {e}")
    sys.exit(0)
PY

echo "[push_prereq_bps] both prereq BPs uploaded."
