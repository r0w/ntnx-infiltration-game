#script

"""
Upload CloneProd + BlankVM-source prereq blueprints.

The .tgz blobs are pre-patched at BUILD time (build_blueprint.py opens
each tar, sed-substitutes `{X}` placeholders to Calm `@@{X}@@` tokens,
re-tars, base64-encodes, and inlines the result here). At RUN time we
only decode the base64 and POST — no `tarfile`, no `io`, none of the
sandbox-banned modules.

Multipart body is hand-constructed so we don't need `requests.files=`
(which calls `urllib3.filepost` which calls `email.mime` which calls
`os.urandom` — at least one link in that chain is a sandbox blocker).

Calm injects @@{PC_IP}@@, @@{PC_USERNAME}@@, @@{PC_PASSWORD}@@,
@@{Game.ProjectUUID}@@.
"""

import base64
import sys
import urllib3
import uuid

import requests

urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

PC_IP = '@@{PC_IP}@@'
PC_USERNAME = '@@{PC_USERNAME}@@'
PC_PASSWORD = '@@{PC_PASSWORD}@@'
PROJECT_UUID = '@@{Game.ProjectUUID}@@'

BASE = "https://%s:9440" % PC_IP
AUTH = (PC_USERNAME, PC_PASSWORD)

CLONEPROD_TGZ_B64 = "__CLONEPROD_TGZ_B64__"
BLANKVM_TGZ_B64 = "__BLANKVM_TGZ_B64__"


def existing_bp_uuid(name):
    r = requests.post(
        "%s/api/nutanix/v3/blueprints/list" % BASE,
        auth=AUTH,
        headers={"Accept": "application/json", "Content-Type": "application/json"},
        verify=False, timeout=20,
        json={"kind": "blueprint", "filter": "name==%s" % name, "length": 1},
    )
    r.raise_for_status()
    entities = r.json().get('entities') or []
    return entities[0]['metadata']['uuid'] if entities else None


def upload_via_multipart(name, tgz_bytes):
    """Hand-rolled multipart/form-data POST (no requests.files=, no io)."""
    boundary = "calmboundary" + uuid.uuid4().hex
    crlf = b"\r\n"
    parts = []
    parts.append(("--" + boundary).encode())
    parts.append(b'Content-Disposition: form-data; name="name"')
    parts.append(b"")
    parts.append(name.encode())
    parts.append(("--" + boundary).encode())
    parts.append(b'Content-Disposition: form-data; name="project_uuid"')
    parts.append(b"")
    parts.append(PROJECT_UUID.encode())
    parts.append(("--" + boundary).encode())
    parts.append(
        ('Content-Disposition: form-data; name="file"; filename="%s.tgz"' % name).encode()
    )
    parts.append(b"Content-Type: application/gzip")
    parts.append(b"")
    parts.append(tgz_bytes)
    parts.append(("--" + boundary + "--").encode())
    parts.append(b"")
    body = crlf.join(parts)
    headers = {
        "Accept": "application/json",
        "Content-Type": "multipart/form-data; boundary=" + boundary,
    }
    r = requests.post(
        "%s/api/nutanix/v3/blueprints/import_file" % BASE,
        auth=AUTH, headers=headers, verify=False, timeout=120,
        data=body,
    )
    if r.status_code >= 400:
        return False, "%d %s" % (r.status_code, r.text[:300])
    return True, "uploaded (%d bytes)" % len(tgz_bytes)


def handle_one(name, tgz_b64):
    if existing_bp_uuid(name):
        print("[skip] '%s' BP already on PC" % name)
        return True
    if not tgz_b64 or tgz_b64.startswith("__"):
        print("[FAIL] '%s' tgz blob not injected — build step missed?" % name)
        return False
    print("Uploading '%s' (pre-patched at build) ..." % name)
    tgz = base64.b64decode(tgz_b64)
    ok, msg = upload_via_multipart(name, tgz)
    print("  %s %s" % ("[ok]" if ok else "[FAIL]", msg))
    return ok


def main():
    if not PROJECT_UUID:
        print("[FAIL] ProjectUUID empty — Setup production project must run first")
        return 2
    success = True
    success &= handle_one("CloneProd", CLONEPROD_TGZ_B64)
    success &= handle_one("BlankVM-source", BLANKVM_TGZ_B64)
    return 0 if success else 1


sys.exit(main())
