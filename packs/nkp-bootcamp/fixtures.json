{
  "kube": {
    "management": {
      "workspaces.kommander.mesosphere.io/v1alpha1/projects": [
        {
          "metadata": {
            "name": "user{UserNum}",
            "namespace": "kommander-default-workspace"
          },
          "spec": {
            "namespaceName": "user{UserNum}",
            "placement": {
              "clusterSelector": {
                "matchLabels": {
                  "infraId": "pc"
                }
              }
            }
          },
          "status": {
            "namespaceRef": {
              "name": "user{UserNum}"
            }
          }
        }
      ],
      "source.toolkit.fluxcd.io/v1/gitrepositories": [
        {
          "metadata": {
            "name": "online-boutique",
            "namespace": "user{UserNum}"
          },
          "spec": {
            "url": "https://github.com/nutanixdev/nkp-microservices-demo.git",
            "ref": {
              "branch": "main"
            }
          },
          "status": {
            "conditions": [
              {
                "type": "Ready",
                "status": "True",
                "message": "stored artifact for revision main"
              }
            ]
          }
        }
      ],
      "apps/v1/deployments": [
        {
          "metadata": {
            "name": "user{UserNum}-nkp-simple-app",
            "namespace": "default"
          },
          "spec": {
            "replicas": 1,
            "template": {
              "spec": {
                "containers": [
                  {
                    "name": "user{UserNum}-nkp-simple-app",
                    "image": "nginx:1.27"
                  }
                ]
              }
            }
          },
          "status": {
            "availableReplicas": 1
          }
        }
      ],
      "v1/services": [
        {
          "metadata": {
            "name": "user{UserNum}-nkp-simple-app",
            "namespace": "default"
          },
          "spec": {
            "type": "LoadBalancer",
            "ports": [
              {
                "port": 80,
                "nodePort": 31347
              }
            ]
          },
          "status": {
            "loadBalancer": {
              "ingress": [
                {
                  "ip": "10.54.30.41"
                }
              ]
            }
          }
        }
      ],
      "networking.k8s.io/v1/ingresses": [
        {
          "metadata": {
            "name": "user{UserNum}-nkp-simple-app",
            "namespace": "default"
          },
          "spec": {
            "ingressClassName": "kommander-traefik",
            "rules": [
              {
                "host": "user{UserNum}.10.54.30.16.sslip.io",
                "http": {
                  "paths": [
                    {
                      "path": "/",
                      "pathType": "Prefix",
                      "backend": {
                        "service": {
                          "name": "user{UserNum}-nkp-simple-app",
                          "port": {
                            "number": 80
                          }
                        }
                      }
                    }
                  ]
                }
              }
            ]
          },
          "status": {
            "loadBalancer": {
              "ingress": [
                {
                  "ip": "10.54.30.16"
                }
              ]
            }
          }
        }
      ]
