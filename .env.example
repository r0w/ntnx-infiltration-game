# ───────────────────────────────────────────────────────────
# ntnx-infiltration-game — server config
# ───────────────────────────────────────────────────────────

GAME_PACK=ntnx-infiltration

PORT=3000
DATA_DIR=./data

# Nutanix transport
MODE=mock                      # mock (fixture-backed, event-safe) | test (real PC + dev tools) | live (real PC, dev tools hidden)
PC_ENDPOINT=                   # https://<pc>:9440
PC_USER=
PC_PASSWORD=
NUTANIX_VERIFY_SSL=false       # HPoC PC uses self-signed; flip to true when the cluster has a real cert
NUTANIX_TIMEOUT_MS=15000       # per-request abort
NUTANIX_MAX_RETRIES=2          # GET/HEAD/OPTIONS retry on 5xx or network errors

# Cluster profile — gates destructive stages (21 create-approval-policy + 28 expand-cluster).
# Operator-set explicitly (no auto-detect — the BP launch dialog is source of truth).
#   hpoc  — recognized lab cluster reserved for the event; destructive stages run.
#   other — community / shared / unknown cluster; destructive stages are skipped.
# Default fallback when unset: 'other' (fail-safe). Ignored in MODE=mock —
# the server forces 'hpoc' there since fixtures aren't a real cluster, so all
# 39 stages play through.
CLUSTER_PROFILE=other          # 'hpoc' or 'other' (forced to hpoc in MODE=mock)

# UX
TYPING_SPEED_MS=15             # per-char typewriter speed hint

# Logging
LOG_LEVEL=info                 # debug | info | warn | error — debug surfaces per-request HTTP traces

# NIG Central (optional anonymous usage stats)
# Unset = telemetry fully off. When set, the server queues session/stage-timing
# events locally and flushes them fire-and-forget; Central being down never
# affects the game. Instance identity = <local ip>-<first boot date>.
NIG_CENTRAL_URL=               # e.g. https://central.example.com
NIG_CENTRAL_TOKEN=             # optional bearer token for the ingest endpoint

# ───────────────────────────────────────────────────────────
# Template-facing initial variables — seed `{Foo}` placeholders rendered
# in the stage prompts. {PC}/{PCUser}/{PCPassword} come from PC_ENDPOINT/
# PC_USER/PC_PASSWORD above; the rest are below. Player-typed vars
# ({Trigram}, {PIN}, {Username}, {NodeSerial}, …) are captured in-game.
# ───────────────────────────────────────────────────────────

# Stage 10 + downstream subnets/blueprints
# `{Vlanid}` — VLAN id used for `{Trigram}-subnet`, the IPAM /24 math
# (192.168.{Vlanid}.0/24), and the `bp-blankvm-prd{Vlanid}` blueprint clone
# (stages 35 + 37). Always allocated collision-free per session (0–249), not
# configurable: pinning a fixed VLAN would break multi-player at stage 10
# (two players' subnets on one VLAN, AHV rejects the second).

# Stage 11 — Ubuntu image source for `{Trigram}-ubuntu`
GAME_IMAGE_URL=https://cloud-images.ubuntu.com/jammy/current/jammy-server-cloudimg-amd64.img

# Stage 27 + 33 — recipient email for `{Trigram}-report` + `{Trigram}-playbook`
# Appended after the trigram, e.g. `cur` + this suffix → `cur-secret-message@…`
GAME_EMAIL_REPORT=-secret-message@ntnxlab.com

# Stage 13 + 14 — AD user the prompt asks the player to log in as before
# the live-migrate (`Production` project owner). Operator-supplied per cluster.
GAME_PROD_USERNAME=
GAME_PROD_PASSWORD=

# Stage 19 — source IP the SSH Traffic Filter must whitelist on the
# microseg policy. Usually the IP/host this game's frontend serves from.
GAME_FRONTEND_HOST=

# Stage 31 (capacity-runway) — secondary Prism Central whose runway dashboard
# the prompt sends the player to. CheckRunway queries `OldPC/v3/groups`
# directly to validate the typed value. All three optional — when unset
# CheckRunway falls back to format-only (numeric input, no live verify).
GAME_OLD_PC=
GAME_OLD_PC_USERNAME=
GAME_OLD_PC_PASSWORD=
